# Backend listen port (default 8080). Vite proxies /api and /ws here in dev.
PORT=8080

# Optional. Override the Vite proxy target if the API is not on this machine.
# BACKEND_ORIGIN=http://127.0.0.1:8080

# How often to push new chart data to WebSocket clients (milliseconds).
# METRICS_INTERVAL_MS=5000

# Server log verbosity: debug | info | warn | error (default info)
# LOG_LEVEL=debug

